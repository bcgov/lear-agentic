				{
					"name": "get-businesses - tasks check no COD",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('should return JSON', function () {",
									"    pm.response.to.have.header('Content-Type', 'application/json');",
									"});",
									"",
									"pm.test(\"Returns tasks - no COD task list\", () => {",
									"    pm.expect(jsonData.tasks).to.exist;",
									"    for (i = 0; i < jsonData.tasks.length; i++) {",
									"        // check type - we don't want COD",
									"        if (jsonData.tasks[i].task.filing) {",
									"            pm.expect(jsonData.tasks[i].task.filing.header.name).not.to.eql('changeOfDirectors')",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
